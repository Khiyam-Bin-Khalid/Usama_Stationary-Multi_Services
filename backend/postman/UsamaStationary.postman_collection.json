{
  "info": {
    "name": "Usama Stationary — Products, Images, Daily/New Sale",
    "description": "Postman walkthrough for authentication, role permissions, product validation and creation, product image upload/public visibility, and the New Sale / Daily Sale flow.\n\nHOW TO FEED DATA: Select the matching Postman environment, set baseUrl and the Super Admin login credentials, then open any request's Body tab to see its ready-to-send example. JSON requests use Body > raw > JSON. Product image upload uses Body > form-data with an image file; re-select postman/fixtures/sample-product.png if Postman cannot resolve the saved file path.\n\nHOW TO RUN: Run requests from top to bottom in Collection Runner. Login and create requests save access tokens, product IDs, and sale IDs as collection variables for later requests. The descriptions on each request explain the exact functionality and fields being tested.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4100/api" },
    { "key": "superadminEmail", "value": "e2e-superadmin@example.com" },
    { "key": "superadminPassword", "value": "E2ePassw0rd!" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login Superadmin",
          "description": "Tests Super Admin authentication. Feed the email and password from the selected environment as raw JSON. Saves the returned access token for subsequent Super Admin-only account creation.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('role is superadmin', () => pm.expect(json.user.role).to.eql('superadmin'));",
                  "pm.collectionVariables.set('superadminToken', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superadminEmail}}\",\n  \"password\": \"{{superadminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register test Admin",
          "description": "Tests that the Super Admin can register an Admin account. The pre-request script generates a unique email; the raw JSON body supplies name, email, password, and role. Uses the Super Admin bearer token.",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('adminEmail', `e2e-admin-${Date.now()}@example.com`);"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('role is admin', () => pm.expect(pm.response.json().user.role).to.eql('admin'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superadminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E Admin\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"AdminPassw0rd!\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register-admin", "host": ["{{baseUrl}}"], "path": ["auth", "register-admin"] }
          }
        },
        {
          "name": "Register test Staff",
          "description": "Tests that the Super Admin can register a Staff account. The pre-request script generates a unique email; the raw JSON body supplies name, email, password, and role. Uses the Super Admin bearer token.",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('staffEmail', `e2e-staff-${Date.now()}@example.com`);"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('role is staff', () => pm.expect(pm.response.json().user.role).to.eql('staff'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superadminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E Staff\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"StaffPassw0rd!\",\n  \"role\": \"staff\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register-staff", "host": ["{{baseUrl}}"], "path": ["auth", "register-staff"] }
          }
        },
        {
          "name": "Login Admin",
          "description": "Tests Admin login using the email created above and its example password. Sends raw JSON and saves the access token for Admin product operations.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"AdminPassw0rd!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Staff",
          "description": "Tests Staff login using the email created above and its example password. Sends raw JSON and saves the access token and Staff user ID for sale and ownership checks.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staffToken', pm.response.json().accessToken);",
                  "pm.collectionVariables.set('staffUserId', pm.response.json().user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"StaffPassw0rd!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Create Product - empty SKU (validation regression)",
          "description": "Tests product input validation by submitting a raw JSON product with an empty sku. Expected result: HTTP 400 with a validation detail naming sku. Uses the Admin bearer token.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "const json = pm.response.json();",
                  "pm.test('error is the generic label', () => pm.expect(json.error).to.eql('Validation failed'));",
                  "pm.test('details name the exact field that is wrong (the bug this fixes)', () => {",
                  "  pm.expect(json.details.some((d) => d.includes('sku'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ballpoint Pen\",\n  \"sku\": \"\",\n  \"category\": \"stationery\",\n  \"price\": 50\n}" },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Staff attempts to create a product (should stay blocked)",
          "description": "Tests role-based access control: Staff submits an otherwise valid raw JSON product, but product creation must be denied with HTTP 403. Uses the Staff bearer token.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 403 — staff stays read-only for products', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ballpoint Pen\",\n  \"sku\": \"PEN-STAFF-1\",\n  \"category\": \"stationery\",\n  \"price\": 50\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Create Product (Admin)",
          "description": "Tests successful Admin product creation and the createdBy audit field. The raw JSON body shows the product name, SKU, category, price, starting stock, and reorder threshold; the SKU is generated for each run. Saves the created product ID and initial stock.",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('productSku', `E2E-${Date.now()}`);"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('createdBy is recorded on the product itself', () => {",
                  "  pm.expect(json.product.createdBy).to.have.property('name');",
                  "  pm.expect(json.product.createdBy.role).to.eql('admin');",
                  "});",
                  "pm.collectionVariables.set('productId', json.product._id);",
                  "pm.collectionVariables.set('productInitialStock', json.product.currentStock);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ballpoint Pen (Box of 10)\",\n  \"sku\": \"{{productSku}}\",\n  \"category\": \"stationery\",\n  \"price\": 300,\n  \"currentStock\": 20,\n  \"reorderThreshold\": 5\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Upload Product Image (Cloudinary or local fallback)",
          "description": "Tests product image upload and image URL generation. In Body > form-data, send the image field as a file and select postman/fixtures/sample-product.png. Re-attach the file if Postman does not resolve its saved path. Uses the Admin bearer token; the backend may return a Cloudinary URL or local /uploads/ URL.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('imageUrl is set (Cloudinary https:// URL or local /uploads/ path)', () => {",
                  "  pm.expect(json.product.imageUrl).to.match(/^(https:\\/\\/res\\.cloudinary\\.com\\/|\\/uploads\\/)/);",
                  "});",
                  "pm.collectionVariables.set('productImageUrl', json.product.imageUrl);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "image", "type": "file", "src": "postman/fixtures/sample-product.png" }]
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/image",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "image"]
            }
          }
        },
        {
          "name": "List Products (Admin — sees who added each one)",
          "description": "Tests the authenticated Admin product list: the new product is returned with createdBy name/role and the image URL from the upload step. Uses the Admin bearer token.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json().products.find((p) => p._id === pm.collectionVariables.get('productId'));",
                  "pm.test('product is in the list', () => pm.expect(product).to.not.be.undefined);",
                  "pm.test('createdBy name/role visible to Admin', () => {",
                  "  pm.expect(product.createdBy).to.have.property('name');",
                  "  pm.expect(product.createdBy.role).to.eql('admin');",
                  "});",
                  "pm.test('image URL from the upload step is present', () => pm.expect(product.imageUrl).to.eql(pm.collectionVariables.get('productImageUrl')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/products?limit=200", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "limit", "value": "200" }] }
          }
        },
        {
          "name": "List Products (Public storefront — image visible, staff identity hidden)",
          "description": "Tests anonymous storefront access: the product and its uploaded image are visible without a token, while the internal createdBy staff identity is omitted.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const product = pm.response.json().products.find((p) => p._id === pm.collectionVariables.get('productId'));",
                  "pm.test('product is visible to anonymous customers', () => pm.expect(product).to.not.be.undefined);",
                  "pm.test('photo is visible to end customers (spec: display image to end users)', () => {",
                  "  pm.expect(product.imageUrl).to.eql(pm.collectionVariables.get('productImageUrl'));",
                  "});",
                  "pm.test('createdBy is never leaked to the public storefront', () => pm.expect(product.createdBy).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/products?limit=200", "host": ["{{baseUrl}}"], "path": ["products"], "query": [{ "key": "limit", "value": "200" }] }
          }
        }
      ]
    },
    {
      "name": "3. Daily Sale / New Sale",
      "item": [
        {
          "name": "New Sale (Staff records a sale)",
          "description": "Tests the POS New Sale flow for Staff. The raw JSON body references the product created earlier, sells quantity 2, and pays by cash; clientTxnId is unique per run. Saves the sale ID. Uses the Staff bearer token.",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('clientTxnId', `e2e-txn-${Date.now()}`);"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('line item matches the product sold', () => pm.expect(json.sale.items[0].quantity).to.eql(2));",
                  "pm.collectionVariables.set('saleId', json.sale._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{staffToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientTxnId\": \"{{clientTxnId}}\",\n  \"items\": [{ \"product\": \"{{productId}}\", \"quantity\": 2 }],\n  \"paymentMethod\": \"cash\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/sales", "host": ["{{baseUrl}}"], "path": ["sales"] }
          }
        },
        {
          "name": "Verify inventory stock was updated by the sale",
          "description": "Tests inventory deduction after the sale by fetching the created product and checking that currentStock decreased by the quantity sold (2). Uses the Staff bearer token.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const expected = pm.collectionVariables.get('productInitialStock') - 2;",
                  "pm.test('currentStock decremented by the quantity sold', () => pm.expect(json.product.currentStock).to.eql(expected));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Daily Sale — Staff sees only their own sales today",
          "description": "Tests the Staff Daily Sale list for today's date range and verifies both that the new sale appears and every returned sale belongs to the logged-in Staff user. The request uses generated ISO date query parameters and the Staff bearer token.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());",
                  "pm.collectionVariables.set('todayStart', start.toISOString());",
                  "pm.collectionVariables.set('now', now.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('today\\'s new sale is in the list', () => {",
                  "  pm.expect(json.sales.some((s) => s._id === pm.collectionVariables.get('saleId'))).to.be.true;",
                  "});",
                  "pm.test('every sale belongs to this staff member', () => {",
                  "  pm.expect(json.sales.every((s) => s.cashier._id === pm.collectionVariables.get('staffUserId'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales?from={{todayStart}}&to={{now}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales"],
              "query": [
                { "key": "from", "value": "{{todayStart}}" },
                { "key": "to", "value": "{{now}}" }
              ]
            }
          }
        },
        {
          "name": "Daily Sale — Admin sees everyone's sales, with cashier name",
          "description": "Tests the Admin Daily Sale list for the same date range: Admin can see the Staff-created sale and the populated cashier name identifies who recorded it. Uses the Admin bearer token.",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/sales?from={{todayStart}}&to={{now}}",
              "host": ["{{baseUrl}}"],
              "path": ["sales"],
              "query": [
                { "key": "from", "value": "{{todayStart}}" },
                { "key": "to", "value": "{{now}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const sale = json.sales.find((s) => s._id === pm.collectionVariables.get('saleId'));",
                  "pm.test('Admin can see the sale the Staff member made, to verify it', () => pm.expect(sale).to.not.be.undefined);",
                  "pm.test('cashier name is populated so Admin can tell who made the sale', () => pm.expect(sale.cashier).to.have.property('name'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
