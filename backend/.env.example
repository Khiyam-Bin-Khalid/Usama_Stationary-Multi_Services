# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed web-app origins (used for CORS + Stripe
# redirect URLs). In development, any http://localhost:<port> or
# http://127.0.0.1:<port> origin is also allowed automatically, since
# `flutter run -d chrome` / `-d web-server` picks a random port each launch.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local install, Docker, or MongoDB Atlas free tier)
MONGODB_URI=mongodb://127.0.0.1:27017/usama_book_depot

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Seed / bootstrap superadmin (used by `npm run seed`)
SUPERADMIN_EMAIL=owner@usamabookdepot.pk
SUPERADMIN_PASSWORD=change_me_strong_password
SUPERADMIN_NAME=Usama Book Depot Owner

# Stripe (leave blank until you have your own keys — app works via
# manual receipt-upload / cash-on-delivery without these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# File uploads (receipts)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
